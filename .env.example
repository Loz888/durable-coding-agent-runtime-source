# Example only. Replace YOUR_LINUX_USER; never commit actual credentials.
DAY12_TEST_DATABASE_URL="host=/var/run/postgresql dbname=agent_runtime_day14_test user=YOUR_LINUX_USER sslmode=disable"
TEST_DATABASE_URL="host=/var/run/postgresql dbname=agent_runtime_test user=YOUR_LINUX_USER sslmode=disable"
# Opt-in regular Worker/server configuration; demos never use these.
# DAY12_DATABASE_URL=
# DATABASE_URL=
WORKTREE_BASE=worktrees
# Optional for manually requested real-model runs; keep it outside version control.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# Day 21 capture writes into a newly created external directory by default.
# DAY21_OUTPUT_DIR=/tmp/agent-runtime-day21-new-run
# DAY21_RUNS_OUT is internal to capture; do not export it for the full suite.
